#!/bin/bash
[ -z "$DEBUG" ] || set -x
set -e
YBIN="$(dirname "$0")"

# bin/kubectl-yconverge is a tracked symlink to the y-bin auto-symlink
# `cluster`, not to this wrapper, so kubectl plugin discovery exec's
# the binary without a shell fork. exec -a preserves the invocation
# name for anything that does come through here under another name.

# Y_CLUSTER_BIN runs an unreleased y-cluster build through everything
# that calls `y-cluster`, which is how y-cluster's changes get verified
# against this repo's acceptance test before a release exists to pin.
# Explicit opt-in only: there is no implicit preference for a dev
# binary. It does not reach `kubectl yconverge`, which resolves through
# the `cluster` symlink; acceptance uses `y-cluster yconverge`.
if [ -n "$Y_CLUSTER_BIN" ]; then
  [ -x "$Y_CLUSTER_BIN" ] || { echo "Y_CLUSTER_BIN=$Y_CLUSTER_BIN is not an executable file" >&2; exit 1; }
  echo "y-cluster: using Y_CLUSTER_BIN=$Y_CLUSTER_BIN instead of the pinned release" >&2
  exec -a "$(basename "$0")" "$Y_CLUSTER_BIN" "$@"
fi

version=$(y-bin-download "$YBIN/y-bin.runner.yaml" cluster)
exec -a "$(basename "$0")" "$YBIN/y-cluster-v${version}-bin" "$@"
