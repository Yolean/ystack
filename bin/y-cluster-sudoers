#!/usr/bin/env bash
[ -z "$DEBUG" ] || set -x
set -eo pipefail

YSTACK_HOME="$(cd "$(dirname "$0")/.." && pwd -P)"
YBIN="$YSTACK_HOME/bin"
SUDOERS_FILE="/etc/sudoers.d/ystack-cluster"
# Root-owned snapshots of the helpers: a NOPASSWD rule for a file its grantee can edit
# would be root for the grantee, so the rules name these copies only
PRIVILEGED_DIR="/usr/local/libexec/ystack"
HELPERS=(y-etc-hosts-write y-localhost)

usage() {
  cat >&2 <<EOF
Usage: y-cluster-sudoers [--write] [--allow-grantee-source] [username ...]

Maintains passwordless sudo rules for automatic development cluster setup.

Without --write: prints the sudoers rules and what --write would install.
With    --write: as root, installs root-owned copies of ${HELPERS[*]}
                 from this checkout to $PRIVILEGED_DIR and writes the rules,
                 which name only those copies, to $SUDOERS_FILE.

Usernames: one or more users to grant NOPASSWD rules to.
           Defaults to the current user (via SUDO_USER or USER).

Run --write from a checkout you trust at a commit you have reviewed, as it copies
the helpers that will run as root. It refuses when a grantee owns or can write the
helpers, this script or any directory above them, or when one of those is a symlink,
unless --allow-grantee-source is given. It cannot vouch for itself: if a grantee
could write this script, running it as root in any mode runs their code. The show
mode run as yourself lists what a grantee owns; group and ACL write access you check
without executing the checkout, e.g. ls -ld on the path, before running it with sudo.
Rerun it after updating ystack to refresh the copies; y-k8s-ingress-hosts warns
when they differ.
EOF
  exit 0
}

[ "$1" = "-h" ] || [ "$1" = "--help" ] && usage

MODE=show
ALLOW_GRANTEE_SOURCE=false
while [ $# -gt 0 ]; do
  case "$1" in
    --write) MODE="write"; shift ;;
    --show) shift ;;
    --allow-grantee-source) ALLOW_GRANTEE_SOURCE=true; shift ;;
    -*) echo "ERROR: unknown option '$1'" >&2; exit 1 ;;
    *) break ;;
  esac
done

USERS=("$@")
for u in "${USERS[@]}"; do
  case "$u" in -*) echo "ERROR: options go before usernames, got '$u'" >&2; exit 1 ;; esac
  id -u "$u" >/dev/null 2>&1 || { echo "ERROR: no such user '$u'" >&2; exit 1; }
done
[ ${#USERS[@]} -eq 0 ] && USERS=("${SUDO_USER:-$USER}")

rules() {
  echo "# ystack development cluster automation"
  echo "# Generated by y-cluster-sudoers for: ${USERS[*]}"
  echo "# Helpers installed from $YSTACK_HOME to $PRIVILEGED_DIR, see $PRIVILEGED_DIR/SOURCE"
  for u in "${USERS[@]}"; do
    cat <<EOF
# y-localhost: loopback alias management ($u), 127.0.0.0/8 only
$u ALL=(root) NOPASSWD: $PRIVILEGED_DIR/y-localhost *
# y-k8s-ingress-hosts: /etc/hosts management ($u)
# Argument-free on purpose, and the copy only accepts changes inside the
# k8s-ingress-hosts block that map to loopback or private addresses.
$u ALL=(root) NOPASSWD: $PRIVILEGED_DIR/y-etc-hosts-write
EOF
  done
}

file_owner() {
  case "$(uname -s)" in
    Darwin) stat -f '%Su' "$1" ;;
    *) stat -c '%U' "$1" ;;
  esac
}

# The helpers, this script, and every directory above them
source_paths() {
  local p d
  for p in "${HELPERS[@]/#/$YBIN/}" "$YBIN/y-cluster-sudoers"; do
    d=$p
    while :; do
      echo "$d"
      [ "$d" = / ] && break
      d=$(dirname "$d")
    done
  done | sort -u
}

# A grantee who owns or can write any source path can change a helper between this check
# and the copy, or swap the checkout itself; a symlink can point anywhere. Write access
# (group, other, ACL) is checked only as root, which --write is.
grantee_controlled_sources() {
  local p owner u
  while IFS= read -r p; do
    if [ -L "$p" ]; then echo "$p is a symlink"; fi
    owner=$(file_owner "$p")
    for u in "${USERS[@]}"; do
      if [ "$owner" = "$u" ]; then
        echo "$p is owned by grantee $u"
      elif [ "$(id -u)" -eq 0 ] && sudo -n -u "$u" test -w "$p"; then
        echo "$p is writable by grantee $u"
      fi
    done
  done < <(source_paths)
}

sudo_rs_check() {
  # sudo-rs (default on Ubuntu 25.10+) has a bug where NOPASSWD rules from
  # /etc/sudoers.d/ are listed by "sudo -l" but not applied during execution.
  # The original sudo (sudo.ws) handles these rules correctly.
  if sudo --version 2>&1 | grep -q "sudo-rs"; then
    echo "" >&2
    echo "WARNING: sudo-rs detected. NOPASSWD rules may not work." >&2
    echo "sudo-rs has a known bug where rules in /etc/sudoers.d/ are parsed" >&2
    echo "but not applied. Switch to the original sudo to fix:" >&2
    echo "  sudo update-alternatives --set sudo /usr/bin/sudo.ws" >&2
  fi
}

if [ "$MODE" = "show" ]; then
  rules
  echo "# --write would install: ${HELPERS[*]/#/$YBIN/} -> $PRIVILEGED_DIR/ (root:0 0755)"
  GRANTEE_CONTROLLED=$(grantee_controlled_sources)
  [ -z "$GRANTEE_CONTROLLED" ] || { echo "# --write would refuse, a grantee controls the source:"; echo "$GRANTEE_CONTROLLED" | sed 's/^/#   /'; }
  sudo_rs_check
  exit 0
fi

if [ "$(id -u)" -ne 0 ]; then
  echo "Writing sudoers rules requires root. Run with sudo, from a checkout root can read:" >&2
  echo "  sudo $0 --write ${USERS[*]}" >&2
  exit 1
fi

GRANTEE_CONTROLLED=$(grantee_controlled_sources)
if [ -n "$GRANTEE_CONTROLLED" ] && [ "$ALLOW_GRANTEE_SOURCE" != "true" ]; then
  echo "ERROR: refusing to install root-run helpers from a checkout a grantee controls:" >&2
  echo "$GRANTEE_CONTROLLED" >&2
  echo "Run from your own ystack checkout, or pass --allow-grantee-source after reviewing it." >&2
  exit 1
fi

TMPFILE=$(mktemp)
trap 'rm -f "$TMPFILE"' EXIT
rules > "$TMPFILE"
if ! visudo -cf "$TMPFILE"; then
  echo "ERROR: Generated sudoers rules failed validation" >&2
  exit 1
fi

install -d -o 0 -g 0 -m 0755 "$PRIVILEGED_DIR"
for h in "${HELPERS[@]}"; do
  install -o 0 -g 0 -m 0755 "$YBIN/$h" "$PRIVILEGED_DIR/$h"
done
# No git as root in a checkout root does not own: its config can run commands
{
  echo "# Installed by y-cluster-sudoers --write for: ${USERS[*]}"
  echo "installed=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  echo "source=$YSTACK_HOME"
  (cd "$PRIVILEGED_DIR" && for h in "${HELPERS[@]}"; do shasum -a 256 "$h" 2>/dev/null || sha256sum "$h"; done)
} > "$PRIVILEGED_DIR/SOURCE.tmp"
chmod 0644 "$PRIVILEGED_DIR/SOURCE.tmp"
mv "$PRIVILEGED_DIR/SOURCE.tmp" "$PRIVILEGED_DIR/SOURCE"

install -o 0 -g 0 -m 0440 "$TMPFILE" "$SUDOERS_FILE"
echo "Installed ${HELPERS[*]} to $PRIVILEGED_DIR, wrote $SUDOERS_FILE"
sudo_rs_check
