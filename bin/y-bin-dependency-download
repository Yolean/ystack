#!/bin/sh
[ -z "$DEBUGDEBUG" ] || set -x
set -e
YBIN="$(dirname $0)"

SHA256SUM="sha256sum"

[ -n "$bin_tar_path" ] || bin_tar_path=$bin_tgz_path
bin_tar_extract=$bin_tar_path
[ -n "$bin_tar_compression" ] || bin_tar_compression=z

platform="$(uname -s)"
case "$platform" in
  Darwin )
    url=$Darwin_url
    sha256=$Darwin_sha256
    SHA256SUM="shasum -a 256"
    ;;
  Linux )
    url=$Linux_url
    sha256=$Linux_sha256
    case "$bin_tar_path" in
      */*/*) ;;
      */*)
        set -o noglob
        bin_tar_extract="--wildcards */$(basename $bin_tar_path)"
        ;;
      *) ;;
    esac
    ;;
  * )
    echo "Unsupported platform $platform" && exit 1
    ;;
esac

[ ! -z "$bin_version" ] || bin_version=$sha256

bin_uniq=y-$bin_name-$bin_version-bin
bin_file=$YBIN/$bin_uniq
bin_link=$YBIN/$bin_name

[ -f $bin_file ] || {
  [ -z "$YSTACK_BIN_DOWNLOAD_CACHE" ] || bin_cache="$YSTACK_BIN_DOWNLOAD_CACHE/$bin_uniq"
  [ -z "$bin_cache" ] || [ ! -f "$bin_cache" ] || url="file://$bin_cache"
  echo "Missing $bin_name binary. Downloading a known version from $url ..." 1>&2
  # Download and unpack under a temporary name, renamed to $bin_file only when complete:
  # an interrupted download (a caller's `| head` is enough) or one still running in another
  # process must never be taken for the binary.
  dl=$(mktemp "$YBIN/.download-$bin_uniq.XXXXXX")
  trap 'rm -f "$dl" "$dl.gunzip"' EXIT
  curl -o $dl -L -f $url
  if ! echo "$sha256  $dl" | $SHA256SUM -c - 1>&2; then $SHA256SUM $dl && exit 1; fi
  if [ ! -z "$bin_tar_path" ]; then
    tmp=$(mktemp -d)
    (cd $tmp; tar -xv${bin_tar_compression}f $dl --strip-components=$(echo $bin_tar_path | awk -F'/' '{print NF-1}') $bin_tar_extract) \
      || (cd $tmp; tar -tv${bin_tar_compression}f $dl; exit 1)
    mv "$tmp/$(basename $bin_tar_path)" $dl
    rm -rf "$tmp"
  fi
  if [ ! -z "$bin_zip_path" ]; then
    tmp=$(mktemp -d)
    (cd $tmp; unzip $dl)
    mv "$tmp/$bin_zip_path" $dl
    rm -rf "$tmp"
  fi
  case "$url" in
    *.tar.gz) ;;
    *.gz) gzip -dc $dl > $dl.gunzip && mv $dl.gunzip $dl ;;
  esac
  chmod 755 $dl
  mv -f $dl $bin_file
  trap - EXIT
  [ -z "$bin_cache" ] || [ -f "$bin_cache" ] || cp -v $bin_file $bin_cache 1>&2
}

if [ "$(readlink $bin_link)" != "$bin_file" ]; then
  [ ! -e $bin_link ] || [ -L $bin_link ] || { echo "Not a symlink, not replacing: $bin_link" >&2; exit 1; }
  # replaced by rename, so a concurrent run never sees the link missing
  ln -s $bin_file $YBIN/.link-$bin_name.$$
  mv -f $YBIN/.link-$bin_name.$$ $bin_link
fi
